PythonServer/venv/

# Runtime-generated data (EmotionDataLogger CSV output)
Assets/EmotionLogs.csv
Assets/EmotionLogs.csv.meta

# Wrong-path MCP artifact (correct scene is Assets/Scenes/EmotionTest.unity)
Assets/EmotionTest.unity
Assets/EmotionTest.unity.meta

# Unity temporary recovery folder
Assets/_Recovery/
Assets/_Recovery.meta
